<%= stylesheet_link_tag "pages/admin/orders" %>

<h1>Order and Fulfillment Management</h1>
<p>List all orders and fulfillment status, with actions to update status and retry or cancel</p>

<table>
    <thead>
        <tr>
        <th>Order ID</th>
        <th>Customer</th>
        <th>Status</th>
        <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% @orders.each do |order| %>
        <tr>
            <td><%= order.id %></td>
            <td><%= order.user.name %></td>
            <td><%= order.status %></td>
            <td>
            <%= button_to "Cancel", cancel_admin_order_path(order), method: :delete, class: "btn btn-danger", data: { turbo: false } %>
            </td>
        </tr>
        <% end %>
    </tbody>
</table>