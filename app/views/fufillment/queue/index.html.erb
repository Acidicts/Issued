<%= stylesheet_link_tag "pages/orders", "pages/fufillment/queue/index" %>

<%
  per_page = Fufillment::QueueController::PER_PAGE
  page = @page.to_i
  prev_page = [page - 1, 0].max
  next_page = page + 1
  range_start = page * per_page + 1
  range_end = page * per_page + @orders.size
%>

<div class="orders-queue-list">
    <div class="orders-queue-nav">
        <%= link_to "&lt;".html_safe, fufillment_queue_index_path(page: prev_page),
              aria: { label: "Previous page", disabled: page.zero? }, data: { turbo_frame: "orders_queue" },
              class: ("is-disabled" if page.zero?) %>
        <p>
            <% if @orders.any? %>
                <%= "#{range_start} to #{range_end}" %>
            <% else %>
                No orders
            <% end %>
        </p>
        <%= link_to "&gt;".html_safe, fufillment_queue_index_path(page: next_page),
              aria: { label: "Next page" }, data: { turbo_frame: "orders_queue" } %>
    </div>
    <div class="orders-queue-grid">
        <%= turbo_frame_tag "orders_queue" do %>
            <%= render partial: "fufillment/queue/order", collection: @orders %>
        <% end %>
    </div>
</div>
