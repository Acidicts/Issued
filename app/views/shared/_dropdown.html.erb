<%#
  Renders a themed custom dropdown around a Rails select field.
  Layers a JS-driven trigger button + popup list on top of a real,
  visually-hidden <select> (see app/javascript/controllers/dropdown_controller.js
  and app/assets/stylesheets/components/dropdown.css) so the open
  state matches the site's theme instead of native OS/browser
  select-popup chrome.

  Required locals:
    form         - the FormBuilder
    method       - the attribute/method name to select

  Optional locals:
    choices      - options array/hash passed to options_for_select (default: [])
    selected     - currently selected value (default: form.object's current value)
    prompt       - placeholder/prompt text shown when nothing is selected
    css_class    - extra class(es) added to the outer .dropdown wrapper
    small        - true for the compact .dropdown--sm size variant

  Usage:
    <%= render "shared/dropdown",
        form: form,
        method: :hackatime_project,
        choices: @hackatime_projects.map { |p| [p['name'], p['name']] },
        selected: @design.hackatime_project,
        prompt: "Select a Hackatime project" %>

<% choices  = local_assigns.fetch(:choices, []) %>
<% selected = local_assigns.fetch(:selected, form.object.public_send(method)) %>
<% prompt   = local_assigns[:prompt] %>
<% wrapper_classes = ["dropdown", local_assigns[:small] ? "dropdown--sm" : nil, local_assigns[:css_class]].compact.join(" ") %>

<div class="<%= wrapper_classes %>" data-controller="dropdown">
  <%= form.select method,
      options_for_select(choices, selected),
      { prompt: prompt },
      class: "dropdown-select", data: { dropdown_target: "select", action: "change->dropdown#syncLabel" } %>

  <button type="button" class="dropdown-trigger"
          data-dropdown-target="trigger"
          data-action="click->dropdown#toggle keydown->dropdown#onKeydown">
    <span class="dropdown-trigger-label" data-dropdown-target="label" data-placeholder="<%= prompt %>"></span>
  </button>

  <ul class="dropdown-menu" role="listbox" data-dropdown-target="menu" hidden></ul>
</div>
