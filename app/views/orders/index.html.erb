<%= stylesheet_link_tag "pages/orders", "data-turbo-track": "reload" %>

<div class="form-card">
    <h1>Your Orders</h1>

    <% if @orders.any? %>
        <% @orders.each do |order| %>
            <%= render "order", order: order %>
        <% end %>
    <% else %>
        <p>You have no orders yet.</p>
    <% end %>
</div>