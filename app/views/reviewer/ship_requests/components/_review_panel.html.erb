<div class="ship-request-project__input">
    <%= form_with model: ship_request, url: reviewer_ship_request_path(ship_request),
        data: {
            controller: "proof-upload",
            action: "submit->proof-upload#submitted direct-uploads:start->proof-upload#start direct-upload:progress->proof-upload#progress direct-uploads:end->proof-upload#finish direct-upload:error->proof-upload#failed turbo:submit-end->proof-upload#finish turbo:submit-failed->proof-upload#finish"
        } do |f| %>
        <div class="ship-card-reviewer-input__comments">
            <%= f.label "Review Message" %>
            <%= f.textarea :comment %>
        </div>

        <div class="ship-card-reviewer-input__comments ship-card-reviewer-input__comments--toggle">
            <%= f.checkbox :make_comment %>
            <%= f.label :make_comment %>
        </div>

        <div class="ship-card-reviewer-input__proof">
            <%= f.label :proof, "Video (Should be a video recorded of testing the project. NOT SETUP)" %>
            <%= f.file_field :proof, accept: "video/*", direct_upload: true %>
            <p class="ship-card-reviewer-input__status" data-proof-upload-target="status" role="status" aria-live="polite"></p>
        </div>

        <div class="ship-card-reviewer-input__approved-time" data-controller="hms-duration" data-hms-duration-seconds-value="<%= ship_request.total_time_seconds %>">
            <%= label_tag nil, "Approved Time" %>
            <div class="ship-card-reviewer-input__approved-time-fields">
                <label>
                    Hours
                    <%= number_field_tag "approved_hours", nil, min: 0, data: { hms_duration_target: "hours", action: "input->hms-duration#recompute" } %>
                </label>
                <label>
                    Minutes
                    <%= number_field_tag "approved_minutes", nil, min: 0, max: 59, data: { hms_duration_target: "minutes", action: "input->hms-duration#recompute" } %>
                </label>
            </div>
            <%= f.hidden_field :approved_seconds, data: { hms_duration_target: "seconds" } %>
        </div>

        <div class="ship-card-reviewer-input__actions">
            <%= f.submit "Approve", name: "status_set", value: "Approve", class: "btn-primary", disabled: !%w[rejected pending].include?(ship_request.status) %>
            <%= f.submit "Reject",  name: "status_set", value: "Reject", class: "btn-primary", disabled: !%w[approved pending].include?(ship_request.status) %>
            <%= f.submit "Elevate", name: "status_set", value: "Elevate", class: "btn-primary", disabled: !%w[approved rejected pending].include?(ship_request.status) %>
        </div>
    <% end %>
</div>
