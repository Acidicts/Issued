<%= stylesheet_link_tag 'pages/devlogs.css', "data-turbo-track": "reload" %>

<div class="devlogs-wrap">
  <div class="devlogs-header">
    <div class="devlogs-header-title">
        <h3>Devlogs</h3>
        <span class="muted">You have <%= format_duration(total_seconds: design.unlogged_time, seconds_enabled: false) %> unlogged</span>
    </div>
    <button class="dd-toggle" type="button" aria-expanded="false" aria-controls="devlog-form-panel" data-dd>
      <span class="dd-toggle__label" data-dd-label data-open="Cancel" data-closed="New Devlog" title="<%= design.can_make_devlog ? "Create New Devlog" : "You need at least 15 minutes per devlog" %>">New Devlog</span>
      <%= render "shared/info_icon", aria_label: "You need at least 15 minutes per devlog" %>
      <span class="dd-toggle__chevron">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 4.5L6 7.5L9 4.5" />
        </svg>
      </span>
    </button>
  </div>

  <div class="dd-panel" id="devlog-form-panel" aria-hidden="true" data-dd-panel>
    <div class="dd-panel__inner">
      <%= render partial: "designs/devlogs/new", locals: { devlog: design.devlogs.new } %>
    </div>
  </div>

  <div class="devlogs-grid">
    <% if design.devlogs.any? %>
        <% design.devlogs.order(created_at: :desc).each do |devlog| %>
          <%= render "designs/devlogs/devlog", devlog: devlog %>
        <% end %>
    <% else %>
      <% time_seconds = design.hackatime_seconds.to_i - design.devlogged_time.to_i %>
      <span class="devlogs-empty">You Have No Devlogs - (You have <%= format_duration(total_seconds: time_seconds) %>)</span>
    <% end %>
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('[data-dd]');
  var panel = document.getElementById('devlog-form-panel');
  if (!root || !panel) return;

  var label = root.querySelector('[data-dd-label]');

  root.addEventListener('click', function () {
    var isOpen = root.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      panel.classList.remove('is-open');
      root.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      label.textContent = label.dataset.closed;
    } else {
      panel.classList.add('is-open');
      root.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      label.textContent = label.dataset.open;
    }
  });
})();
</script>
