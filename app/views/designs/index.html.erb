<%= stylesheet_link_tag "pages/designs.css"%>

<div class="design">
  <div class="design-heading-actions">
    <h1 id="your-designs-heading">Your Designs</h1>
    <% if !current_user.designs.empty? %>
      <%= link_to "Create New Design", new_design_path, class: "btn" %>
    <% end %>
  </div>
  <hr style="margin-bottom: 2rem">
  <div class="designs-list">
    <%= render @designs %>
  </div>
  <% if @designs.empty? %>
    <div class="empty-state">
      <%= link_to "Create your first design", new_design_path, class: "create-link btn btn-secondary" %>
      <p>You haven't created any designs yet.</p>
    </div>
  <% end %>
</div>