<%= turbo_frame_tag "comment_#{comment.id}" do %>
  <div class="comment-card">
    <div class="comment-card-contents">
      <div class="comment-card-header">
        <div>
          <% if comment.created_at %>
            <time class="comment-card-date" datetime="<%= comment.created_at.iso8601 %>">
              <%= comment.created_at.strftime("%b %d, %Y") %>
            </time>
          <% end %>
        </div>

        <div class="comment-card-header__time_edit">
          <% if comment.id && comment.user == current_user %>
            <%= link_to edit_comment_path(comment.id) do %>
              <span class="comment-card-header__edit_btn"><%= edit_svg(width: "1.55rem", height: "1.55rem", color: "var(--line)")%></span>
            <% end %>
            <%= button_to comment_path(comment.id), method: :delete do %>
              <span class="comment-card-header__edit_btn"><%= delete_svg(width: "1.55rem", height: "1.55rem", color: "var(--line)")%></span>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="comment-card-body markdown-content">
        <%= raw MarkdownService.convert(content: comment.body) %>
      </div>
    </div>
  </div>
<% end %>