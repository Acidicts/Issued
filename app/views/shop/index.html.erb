<%= stylesheet_link_tag "pages/shop", "data-turbo-track": "reload" %>

<div class="shop-wrap">
  <div class="shop-header">
    <h1>The Loom</h1>
    <%= link_to "View Orders", orders_path, class: "btn btn-secondary" %>
  </div>

  <% if @products.any? %>
    <div class="shop-grid">
      <% @products.each do |product| %>
        <%= render "shop/product", product: product %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-shop">
      <p>No products available yet.</p>
    </div>
  <% end %>
</div>
