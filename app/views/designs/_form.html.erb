<%= form_with model: @design, html: { multipart: true, class: "design-form", data: { turbo: false, controller: "disable-button", disable_button_with_value: "Creating...", action: "submit->disable-button#disable" } } do |form| %>
  <h1 class="design-form-heading"><%= heading %></h1>
  
  <% if @design.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@design.errors.count, "error") %> prohibited this design from being saved:</h2>
      <ul>
        <% @design.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <% possessive_name = current_user.name.end_with?('s') ? "#{current_user.name}' Master Piece" : "#{current_user.name}'s Master Piece" %>
    <%= form.text_field :name, placeholder: possessive_name %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, placeholder: "This is the best becuase " + current_user.name + " made it!" %>
  </div>

  <% if @hackatime_projects.present? %>
    <div class="field">
      <%= form.label :hackatime_project, "Hackatime project" %>
      <%= render "shared/dropdown",
          form: form,
          method: :hackatime_project,
          choices: @hackatime_projects.map { |project| ["#{project['name']} (#{format("%02d:%02d:%02d", project['seconds'].to_i / 3600, (project['seconds'].to_i / 60) % 60, project['seconds'].to_i % 60)})", project['name']] },
          selected: @design.hackatime_project,
          prompt: "Select a Hackatime project" %>
      <p class="muted">Selected Hackatime project time will be added to this design.</p>
    </div>
  <% elsif current_user&.slack_id.present? && HackatimeService.available? %>
    <p class="muted">No Hackatime projects were found for your account.</p>
  <% end %>

  <div class="field file-field">
    <%= form.label :image, "Image" %>
    <%= form.file_field :image %>
  </div>

  <div class="field">
    <label>
      <%= form.check_box :remove_background %>
      Remove background from uploaded image
    </label>
  </div>

  <div class="actions">
    <%= form.submit @design.persisted? ? "Update Design" : "Create Design", class: "button button-primary" %>
    <% if @design.persisted? %>
      <%= link_to "Back", designs_path, class: "button button-secondary" %>
    <% end %>
  </div>
<% end %>
