<%= form_with model: @design, url: design_path(@design), method: :patch, html: { class: "design-form design" } do |form| %>
    <h2>Hackatime Projects</h2>
    <% if @design.hackatime_projects.any? %>
      <div class="hackatime-pills">
        <% @design.hackatime_projects.each do |hp| %>
          <%= render "designs/pill", hackatime_project: hp, design: @design %>
        <% end %>
      </div>
    <% end %>

    <% available_projects = @hackatime_projects.reject { |p| @design.hackatime_projects.pluck(:name).include?(p['name']) } %>
    <% if available_projects.present? %>
        <%= render "shared/dropdown",
            form: form,
            method: :hackatime_project,
            choices: available_projects.map { |project| ["#{project['name']} (#{format("%02d:%02d:%02d", project['seconds'].to_i / 3600, (project['seconds'].to_i / 60) % 60, project['seconds'].to_i % 60)})", project['name']] },
            prompt: "Add a Hackatime project" %>
        <p class="muted">Select a Hackatime project and save to add it.</p>
    <% elsif @design.hackatime_projects.none? && current_user&.slack_id.present? && HackatimeService.available? %>
        <div class="hackatime-form-no-projects">
            <p class="muted">No Hackatime projects were found for your account.</p>
            <p class="muted">Get started <a class="btn btn-tertiary" href="hackatime.hackclub.com">here</a>
        </div>
    <% end %>

    <div class="actions">
        <%= form.submit @design.persisted? ? "Update Design" : "Create Design", class: "button button-primary" %>
        <% if @design.persisted? %>
            <%= link_to "Back", designs_path, class: "button button-secondary" %>
        <% end %>
    </div>
<% end %>