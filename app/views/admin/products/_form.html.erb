<%= stylesheet_link_tag "components/tokens" %>
<%= stylesheet_link_tag "components/forms" %>
<%= stylesheet_link_tag "pages/admin/products" %>

<%
  img_url = if @product&.image&.attached?
              url_for(@product.image)
            else
              ""
            end

  print_areas_data = @product.print_areas.map do |pa|
    {
      id: pa.id,
      name: pa.name,
      image_x: pa.image_x.to_i,
      image_y: pa.image_y.to_i,
      image_wx: pa.image_wx.to_i,
      image_wy: pa.image_wy.to_i,
      cost: pa.cost.to_f,
      thread_cost: pa.thread_cost.to_i,
      template_image_url: pa.template_image.attached? ? url_for(pa.template_image) : ""
    }
  end.to_json
%>

<div data-controller="product-preview"
     data-product-preview-img-url-value="<%= img_url %>"
     data-product-preview-print-areas-value="<%= print_areas_data %>">

  <%= form_for [:admin, @product], html: { multipart: true, class: 'form-card', data: { turbo: false, action: "submit->product-preview#syncBeforeSubmit" } } do |f| %>
    <div class="form-header">
      <h1><%= @product.new_record? ? "New Product" : "Edit Product" %></h1>
      <p>Manage product details, pricing, and media assets.</p>
    </div>

    <div class="admin-product-layout">
      <div class="admin-product-fields">
        <div class="form-group <%= 'has-error' if @product.errors[:type].present? %>">
          <%= f.label :type, class: 'form-label' %>
          <%= f.text_field :type, class: 'form-input' %>
          <% if @product.errors[:type].present? %>
            <div class="form-error"><%= @product.errors[:type].join(', ') %></div>
          <% end %>
        </div>

        <div class="form-group <%= 'has-error' if @product.errors[:description].present? %>">
          <%= f.label :description, class: 'form-label' %>
          <%= f.text_area :description, class: 'form-input' %>
          <% if @product.errors[:description].present? %>
            <div class="form-error"><%= @product.errors[:description].join(', ') %></div>
          <% end %>
        </div>

        <div class="form-grid">
          <div class="form-group <%= 'has-error' if @product.errors[:cost].present? %>">
            <%= f.label :cost, "Cost (USD)", class: 'form-label' %>
            <%= f.number_field :cost, step: 0.01, class: 'form-input' %>
            <% if @product.errors[:cost].present? %>
              <div class="form-error"><%= @product.errors[:cost].join(', ') %></div>
            <% end %>
          </div>

          <div class="form-group <%= 'has-error' if @product.errors[:thread_cost].present? %>">
            <%= f.label :thread_cost, "Cost Threads", class: 'form-label' %>
            <%= f.number_field :thread_cost, step: 1, class: 'form-input' %>
            <% if @product.errors[:thread_cost].present? %>
              <div class="form-error"><%= @product.errors[:thread_cost].join(', ') %></div>
            <% end %>
          </div>
        </div>

        <div class="form-group">
          <%= f.label :enabled, "Enabled", class: "form-check" do %>
            <span class="form-check-label">
              Enabled
              <span class="desc">Choose if product is visible.</span>
            </span>
          <% end %>
          <%= f.check_box :enabled, class: "form-checkbox" %>
        </div>
        
        <div class="form-group">
          <%= f.label :image, "Product image", class: 'form-label' %>

          <label class="form-dropzone" for="product_image">
            <div class="dropzone-content">
              <span class="icon">⇪</span>
              <span class="label">Click to upload product image</span>
              <span class="sub">PNG, JPG, or WEBP formats</span>
            </div>
            <%= f.file_field :image, accept: 'image/*', id: 'product_image',
                  data: { action: "change->product-preview#imageSelected" } %>
          </label>

          <% if @product&.image&.attached? %>
            <div class="form-file-item">
              <div class="d-flex align-items-center gap-2">
                <%= image_tag @product.image.variant(:thumb), alt: "Product image", style: "max-width: 48px; border-radius: 4px;" %>
                <span class="name"><%= @product.image.filename.to_s %></span>
                <span class="name"><%= "#{@product.image.blob.metadata['width']}px x #{@product.image.blob.metadata['height']}px" %></span>
              </div>
            </div>
          <% end %>
        </div>

        <fieldset class="form-fieldset">
          <legend>Design placement</legend>
          <p class="form-hint" style="margin-bottom: 12px;">Drag the overlay on the preview to position, or edit values below.</p>

          <div class="print-area-controls">
            <div class="form-group print-area-select-group">
              <select id="product_print_area_select"
                      class="form-select"
                      data-product-preview-target="printAreaSelect"
                      data-action="change->product-preview#printAreaChanged">
                <option value="">Select a Print Area...</option>
                <% @product.print_areas.each do |print_area| %>
                  <option value="<%= print_area.id %>"><%= print_area.name %></option>
                <% end %>
              </select>
            </div>
            <div class="print-area-actions">
              <button type="button" class="btn-secondary btn btn-sm" data-action="click->product-preview#addPrintArea">+ New</button>
              <button type="button" class="btn-danger btn btn-sm" data-action="click->product-preview#removePrintArea">Delete</button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Print area name</label>
            <input type="text" class="form-input"
                   data-product-preview-target="printAreaName">
          </div>

          <div class="form-grid">
            <div class="form-group">
              <%= f.label :image_x, "X position (px)", class: 'form-label' %>
              <%= f.number_field :image_x, step: 1, class: 'form-input',
                    data: { product_preview_target: "inputX", action: "input->product-preview#inputChanged" } %>
            </div>
            <div class="form-group">
              <%= f.label :image_y, "Y position (px)", class: 'form-label' %>
              <%= f.number_field :image_y, step: 1, class: 'form-input',
                    data: { product_preview_target: "inputY", action: "input->product-preview#inputChanged" } %>
            </div>
          </div>
          <div class="form-grid">
            <div class="form-group">
              <%= f.label :image_wx, "Width (px)", class: 'form-label' %>
              <%= f.number_field :image_wx, step: 1, class: 'form-input',
                    data: { product_preview_target: "inputWx", action: "input->product-preview#inputChanged" } %>
            </div>
            <div class="form-group">
              <%= f.label :image_wy, "Height (px)", class: 'form-label' %>
              <%= f.number_field :image_wy, step: 1, class: 'form-input',
                    data: { product_preview_target: "inputWy", action: "input->product-preview#inputChanged" } %>
            </div>
          </div>

          <legend>Costs</legend>
          <div class="form-grid form-fieldset">
            <div class="form-group">
              <%= label_tag :print_area_cost, "Additional cost", class: "form-label" %>
              <%= number_field_tag :print_area_cost, nil, 
                    step: "0.01", 
                    class: "form-input", 
                    id: "print_area_cost",
                    data: { 
                      product_preview_target: "inputCost", 
                      action: "input->product-preview#inputChanged" 
                    } %>
            </div>
            <div class="form-group">
              <%= label_tag :print_area_thread_cost, "Thread cost", class: "form-label" %>
              <%= number_field_tag :print_area_thread_cost, nil, 
                    step: "1", 
                    class: "form-input", 
                    id: "print_area_thread_cost",
                    data: { 
                      product_preview_target: "inputThreadCost", 
                      action: "input->product-preview#inputChanged" 
                    } %>
            </div>
          </div>

          <div class="form-group">
            <%= f.label :print_area_template_image, "Template image (optional)", class: 'form-label' %>
            <label class="form-dropzone form-dropzone-sm" for="print_area_template_image">
              <div class="dropzone-content">
                <span class="label">Click to upload template image</span>
              </div>
              <input type="file" accept="image/*" id="print_area_template_image"
                     data-product-preview-target="templateImageInput"
                     data-action="change->product-preview#templateImageFileChanged">
            </label>
            <input type="hidden" data-product-preview-target="templateImageUrl">
          </div>

          <%= f.hidden_field :print_areas_json, value: print_areas_data, data: { product_preview_target: "printAreasJson" } %>
        </fieldset>

        <fieldset class="form-fieldset">
          <legend>Variants</legend>

          <div id="variants-container" data-controller="variants">
            <% @product.variants.group_by(&:color_hex).each do |hex, variants| %>
              <details class="variant-color-dropdown">
                <summary class="variant-color-summary">
                  <span class="variant-color-dot" style="background-color: <%= hex %>;"></span>
                  <span class="variant-color-hex"><%= hex %></span>
                  <span class="variant-color-count"><%= variants.size %></span>
                </summary>
                <div class="variant-color-body">
                  <% variants.each do |variant| %>
                    <%= f.fields_for :variants, variant do |vf| %>
                      <%= render "variant_fields", vf: vf %>
                    <% end %>
                  <% end %>
                </div>
              </details>
            <% end %>

            <template data-variants-target="template">
              <%= f.fields_for :variants, Variant.new(color_hex: "#ffffff"), child_index: "NEW_RECORD" do |vf| %>
                <%= render "variant_fields", vf: vf %>
              <% end %>
            </template>

            <button type="button" class="btn-secondary btn" data-action="click->variants#add">+ Add variant</button>
          </div>
        </fieldset>

        <div class="form-actions align-start">
          <%= f.submit class: 'btn btn-secondary' %>
        </div>
      </div>

      <div class="admin-product-preview-side">
        <div class="preview-label">Live preview</div>
        <div class="preview-canvas"
             data-product-preview-target="canvas"
             data-action="mousedown->product-preview#dragStart">
          <% if @product&.image&.attached? %>
            <%= image_tag @product.image, alt: "Product preview",
                  class: "preview-product-img",
                  data: { product_preview_target: "templateImage" } %>
          <% else %>
            <div class="preview-placeholder" data-product-preview-target="placeholder">
              Upload a product image to preview
            </div>
          <% end %>
          <div class="preview-design-box"
               data-product-preview-target="designBox"
               style="display: none;">
            <span class="preview-design-label">Design area</span>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
