<%= stylesheet_link_tag "components/tokens" %>
<%= stylesheet_link_tag "components/forms" %>

<%= form_for [:admin, @product], html: { multipart: true, class: 'form-card' } do |f| %>
  <div class="form-header">
    <h1><%= @product.new_record? ? "New Product" : "Edit Product" %></h1>
    <p>Manage product details, pricing, and media assets.</p>
  </div>

  <div class="form-group <%= 'has-error' if @product.errors[:type].present? %>">
    <%= f.label :type, class: 'form-label' %>
    <%= f.text_field :type, class: 'form-input' %>
    <% if @product.errors[:type].present? %>
      <div class="form-error"><%= @product.errors[:type].join(', ') %></div>
    <% end %>
  </div>

  <div class="form-grid">
    <div class="form-group <%= 'has-error' if @product.errors[:cost].present? %>">
      <%= f.label :cost, "Cost (USD)", class: 'form-label' %>
      <%= f.number_field :cost, step: 0.01, class: 'form-input' %>
      <% if @product.errors[:cost].present? %>
        <div class="form-error"><%= @product.errors[:cost].join(', ') %></div>
      <% end %>
    </div>

    <div class="form-group <%= 'has-error' if @product.errors[:thread_cost].present? %>">
      <%= f.label :thread_cost, "Cost Threads", class: 'form-label' %>
      <%= f.number_field :thread_cost, step: 1, class: 'form-input' %>
      <% if @product.errors[:thread_cost].present? %>
        <div class="form-error"><%= @product.errors[:thread_cost].join(', ') %></div>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :image, "Product image", class: 'form-label' %>
    
    <label class="form-dropzone" for="product_image">
      <div class="dropzone-content">
        <span class="icon">⇪</span>
        <span class="label">Click to upload product image</span>
        <span class="sub">PNG, JPG, or WEBP formats</span>
      </div>
      <%= f.file_field :image, accept: 'image/*', id: 'product_image' %>
    </label>

    <% if @product&.image&.attached? %>
      <div class="form-file-item">
        <div class="d-flex align-items-center gap-2">
          <%= image_tag @product.image, alt: "Product image", style: "max-width: 48px; border-radius: 4px;" %>
          <span class="name"><%= @product.image.filename.to_s %></span>
        </div>
      </div>
    <% end %>
  </div>

  <div class="form-actions align-end">
    <%= f.submit class: 'btn btn-primary' %>
  </div>
<% end %>