<%# locals: { show: false } %>
<% if show && current_user && !@current_path.include?("rsvp") && !@current_user.guide %>

  <style>
    .todo-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .todo_section {
      background-color: #f9f9f9;
      padding: 20px;
      border-radius: 8px;
      max-width: 480px;
      width: 90%;
    }

    .todo-section h3 {
      margin-top: 0;
      font-size: 1.5em;
    }

    .todo-section p {
      margin-bottom: 0;
      font-size: 1em;
      color: #666;
    }

    @media (max-width: 768px) {
      .todo_section {
        padding: 15px;
      }

      .todo-section h3 {
        font-size: 1.2em;
      }

      .todo-section p {
        font-size: 0.9em;
      }
    }

    @media (prefers-color-scheme: dark) {
      .todo_section {
        background-color: #1e1e1e;
        color: #f9f9f9;
      }

      .todo-section p {
        color: #ccc;
      }
    }
  </style>

  <div class="todo-overlay">
    <section class="todo_section" id="todo-section">
      <div class="container">
        <div class="todo-section">
          <% if current_user.slack_id.blank? %>
            <h3>Connect Your Account</h3>
            <p>Link your Hackatime with a slack account to start with Issued.</p>
            <%= link_to "Connect Account", "https://hackatime.hackclub.com", class: "brand-btn btn-primary", style: "margin-top: 1rem;" %>
          <% elsif current_user.designs.empty? && @current_path != designs_path%>   
            <h3>Create Your First Design</h3>
            <p>Head to designs to start creating your apparel.</p>
            <%= link_to "Create Design", new_design_path, class: "brand-btn btn-primary", style: "margin-top: 1rem;" %>
          <% end %>
        </div>
      </div>
    </section>
  </div>
<% end %>
