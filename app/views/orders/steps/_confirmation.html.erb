<%= stylesheet_link_tag "pages/orders", "data-turbo-track": "reload" %>

<% enabled_area_names = @product.print_areas.select { |pa| @order.print_areas[pa.name] == true }.map(&:name) %>
<% preview_index = (params[:preview_area] || 0).to_i %>
<% preview_index = [preview_index, enabled_area_names.size - 1].min %>
<% current_area_name = enabled_area_names[preview_index] %>
<% pa = @product.print_areas.find { |p| p.name == current_area_name } %>
<% current_config = @print_area_configs[current_area_name] || {} %>

<%= turbo_frame_tag "order_steps" do %>
  <div class="order-wrap">
    <div class="order-header">
      <h1>Confirm Order</h1>
      <p class="sub">Review your order details before placing it.</p>
    </div>

    <div class="order-layout">
      <div class="order-form-side">
        <%= form_with model: @order, url: orders_path, method: :post, id: "confirmation-form", html: { class: "form-card", data: { turbo: false } } do |f| %>
          <%= f.hidden_field :product_id, value: @product.id %>
          <%= f.hidden_field :color_hex, value: @order.color_hex %>
          <%= hidden_field_tag "order[preview_area]", preview_index %>
          <%= hidden_field_tag "print_area", current_area_name %>

          <% @product.print_areas.each do |pa| %>
            <%= hidden_field_tag "order[print_areas][#{pa.name}]", @order.print_areas[pa.name] == true ? "1" : "0" %>
          <% end %>
          <% @print_area_configs.each do |key, config| %>
            <% config.each do |k, value| %>
              <%= hidden_field_tag "order[print_area_configs][#{key}][#{k}]", value %>
            <% end %>
          <% end %>

          <div class="form-group">
            <span class="form-label">Product</span>
            <div class="order-product-summary">
              <% if @product.image.attached? %>
                <%= image_tag @product.image.variant(:thumb), alt: @product.type, class: "order-product-thumb" %>
              <% end %>
              <div>
                <strong><%= @product.type %></strong>
                <span class="order-product-cost"><%= @product.thread_cost %> threads</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <span class="form-label">Colour</span>
            <div style="display: flex; align-items: center; gap: 8px;">
              <div style="background-color: <%= @order.color_hex %>; width: 32px; height: 32px; border-radius: 4px;"></div>
              <span><%= @order.color_hex %></span>
            </div>
          </div>

          <div class="form-group">
            <span class="form-label">Print Areas</span>
            <% @print_area_configs.each do |area_name, config| %>
              <% design = @designs.find { |d| d.id.to_s == config["design_id"].to_s } %>
              <% area_pa = @product.print_areas.find { |p| p.name == area_name.to_s } %>
              <div style="padding: 8px 0; border-bottom: 1px solid var(--border-light);">
                <span class="print-area-badge"><%= area_name.humanize %> - <%= design.name %></span>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="form-actions">
          <%= button_to "Back", new_step_orders_path, params: { order: { product_id: @product.id, color_hex: @order.color_hex, print_areas: @order.print_areas, print_area_configs: @print_area_configs }, back_step: "design" }, method: :post, data: { turbo_frame: "order_steps" }, class: "btn btn-secondary btn-outline" %>
          <input type="submit" value="Place Order" form="confirmation-form" class="btn btn-secondary">
        </div>
      </div>

      <div class="order-preview-side">
        <div class="preview-label">Preview</div>
        <div class="preview-canvas" style="position: relative;">
          <div class="preview-product">
            <div class="preview-product-image-container" style="position: relative;"
                 data-confirmation-preview
                 data-pa-x="<%= pa&.image_x %>"
                 data-pa-y="<%= pa&.image_y %>"
                 data-pa-wx="<%= pa&.image_wx %>"
                 data-pa-wy="<%= pa&.image_wy %>"
                 data-design-x="<%= current_config["x"] || pa&.image_x %>"
                 data-design-y="<%= current_config["y"] || pa&.image_y %>"
                 data-design-wx="<%= current_config["wx"] || pa&.image_wx %>"
                 data-design-wy="<%= current_config["wy"] || pa&.image_wy %>"
                 data-design-rotation="<%= current_config["rotation"] || 0 %>">
              <% if pa&.template_image %>
                <%= image_tag pa.template_image, alt: @product.type, class: "product_image_preview confirmation-image", style: "background-color: #{@order.color_hex}" %>
              <% elsif @product.image.attached? %>
                <%= image_tag @product.image, alt: @product.type, class: "product_image_preview confirmation-image", style: "background-color: #{@order.color_hex}" %>
              <% else %>
                <span class="preview-placeholder">No product image</span>
              <% end %>
              <% if @design_images[current_area_name.to_s] %>
                <%= image_tag @design_images[current_area_name.to_s], alt: "Design", class: "confirmation-design-image", data: { confirmation_design: true } %>
              <% end %>
            </div>
          </div>
        </div>
        <% if enabled_area_names.size > 1 %>
          <div style="display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 12px;">
            <%= button_to raw("&larr;"), new_step_orders_path, params: { order: { product_id: @product.id, color_hex: @order.color_hex, print_areas: @order.print_areas, print_area_configs: @print_area_configs }, back_step: "confirmation", preview_area: [preview_index - 1, 0].max }, method: :post, data: { turbo_frame: "order_steps" }, class: "btn btn-tertiary", disabled: preview_index <= 0 %>
            <span><%= preview_index + 1 %> / <%= enabled_area_names.size %></span>
            <%= button_to raw("&rarr;"), new_step_orders_path, params: { order: { product_id: @product.id, color_hex: @order.color_hex, print_areas: @order.print_areas, print_area_configs: @print_area_configs }, back_step: "confirmation", preview_area: [preview_index + 1, enabled_area_names.size - 1].min }, method: :post, data: { turbo_frame: "order_steps" }, class: "btn btn-tertiary", disabled: preview_index >= enabled_area_names.size - 1 %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    (function() {
      var container = document.querySelector("[data-confirmation-preview]");
      if (!container) return;
      var img = container.querySelector(".confirmation-image");
      var design = container.querySelector("[data-confirmation-design]");
      if (!img || !design) return;

      function positionDesign() {
        if (!img.naturalWidth || !img.clientWidth) return;

        var imgAspect = img.naturalWidth / img.naturalHeight;
        var boxAspect = img.clientWidth / img.clientHeight;
        var renderedW, renderedH, renderedX, renderedY;
        if (imgAspect >= boxAspect) {
          renderedW = img.clientWidth;
          renderedH = img.clientWidth / imgAspect;
        } else {
          renderedH = img.clientHeight;
          renderedW = img.clientHeight * imgAspect;
        }
        renderedX = (img.clientWidth - renderedW) / 2;
        renderedY = (img.clientHeight - renderedH) / 2;
        var scale = renderedW / img.naturalWidth;
        var offsetX = renderedX;
        var offsetY = renderedY;

        var paX = parseFloat(container.dataset.paX) || 0;
        var paY = parseFloat(container.dataset.paY) || 0;
        var paWx = parseFloat(container.dataset.paWx) || img.naturalWidth;
        var paWy = parseFloat(container.dataset.paWy) || img.naturalHeight;

        var dX = parseFloat(container.dataset.designX) || paX;
        var dY = parseFloat(container.dataset.designY) || paY;
        var dWx = parseFloat(container.dataset.designWx) || paWx;
        var dWy = parseFloat(container.dataset.designWy) || paWy;
        var rotation = parseFloat(container.dataset.designRotation) || 0;

        var left = offsetX + dX * scale;
        var top = offsetY + dY * scale;
        var width = dWx * scale;
        var height = dWy * scale;

        design.style.position = "absolute";
        design.style.left = left + "px";
        design.style.top = top + "px";
        design.style.width = width + "px";
        design.style.height = height + "px";
        design.style.transform = "rotate(" + rotation + "deg)";
        design.style.transformOrigin = "center center";
        design.style.objectFit = "contain";
        design.style.display = "block";
      }

      function tryPosition() {
        if (img.complete && img.naturalWidth) {
          positionDesign();
        } else {
          img.addEventListener("load", positionDesign);
        }
      }

      if (img.complete && img.naturalWidth) {
        requestAnimationFrame(tryPosition);
      } else {
        img.addEventListener("load", function() {
          requestAnimationFrame(positionDesign);
        });
      }
      window.addEventListener("resize", positionDesign);
    })();
  </script>
<% end %>
