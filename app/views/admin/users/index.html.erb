<%= stylesheet_link_tag "pages/admin/users" %>

<h1>User Management</h1>
<div class="users-container">
    <table class="user-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Slack ID</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% @users.each do |user| %>
                <%= render "admin/users/user", user: user %>
            <% end %>
        </tbody>
    </table>
</div>

