<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Issued" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Issued">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%# stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "components/layouts/admin" %>
    <%= stylesheet_link_tag "components/brand" %>
    <%= stylesheet_link_tag "components/buttons" %>
  </head>

  <body>
    <% if @nav != nil %>
      <header>
        <nav>
          <div style="position: relative; width: 100%; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; gap: 1rem; align-items: center; left: 1rem;">
              <%= link_to "Home", admin_overview_path, class: "nav-link" %>
              <%= link_to "Orders", admin_orders_path, class: "nav-link" %>
              <%= link_to "Products", admin_products_path, class: "nav-link" %>
              <%= link_to "RSVPs", admin_rsvp_path, class: "nav-link" %>
              <%= link_to "Users", admin_users_path, class: "nav-link" %>
            </div>
            <div style="display: flex; gap: 1rem; align-items: center; right: 1rem; position: absolute; top: 0; bottom: 0; margin: auto;">
              <% if signed_in? %>
                <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
                <%= link_to "Logout", logout_path, method: :delete, class: "nav-link", data: { turbo: false } %>
              <% else %>
                <%= link_to "Login", login_path(redirect: request.fullpath), class: "nav-link" %>
              <% end %>
            </div>
          </div>
        </nav>
      </header>
    <% end %>

    <div id="flash-container" aria-live="polite" aria-atomic="true">
      <% flash.each do |type, message| %>
        <div class="flash-message flash-<%= type %>"><%= message %></div>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
