<%= stylesheet_link_tag "components/layouts/theme" %>

<style>
  html {
    -webkit-font-smoothing: antialiased;
  }
  
  body {
    font-family: 'Space Mono', 'Courier New', monospace;
    margin: 0;
    padding: 2rem;
    color: #222222;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    
    background-color: var(--bg);
    background-image: repeating-linear-gradient(
      2deg,
      transparent 0,
      transparent 31px,
      var(--line_color) 31px,
      var(--line_color) 32px
    );
  }

  #container {
    max-width: 600px;
    width: 100%;
    text-align: center;
  }

  h1 {
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-size: 6rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  #title {
    font-family: "PaperCrown";
    font-size: clamp(5rem, 10vw, 12rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--accent-text-color);
  }

  p {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    color: #666666;
  }

  .section {
    width: min(70%, 600px);
    aspect-ratio: 1 / 0.3;
    background: var(--note-yellow, #ffe66d);
    border: 0;
    border-radius: 2px 2px 3px 14px / 2px 2px 3px 6px;
    box-shadow:
        1px 2px 3px rgba(43, 42, 51, 0.25),
        0 9px 8px -7px rgba(43, 42, 51, 0.3);
    padding: var(--space-3) var(--space-2);
    font-family: var(--hand-font, 'Patrick Hand', 'Comic Sans MS', cursive);
    font-size: 1.35rem;
    line-height: 1.45;
    color: var(--ink);
    text-align: left;
    margin: 1rem auto;
  }

  .section:first-child {
    transform: rotate(-4deg) translateX(48px);
  }

  .section:last-child {
    transform: rotate(3deg) translateX(-48px) translateY(20px);
  }

  .section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  .section p {
    margin: 0;
    color: #555555;
  }

  @media (prefers-color-scheme: dark) {
    body {
      background: #0f0f0f;
      color: #f5f5f5;
    }

    h1 {
      color: #f5f5f5;
    }

    p {
      color: #b0b0b0;
    }

    .section {
      border-left-color: #F2EAD3;
      background: rgba(255, 255, 255, 0.05);
    }

    .section p {
      color: #a0a0a0;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    #container {
      padding: 1rem;
    }

    .section {
      padding: 1.5rem;
    }
  }
</style>

<div id="container">
  <div class="workbench" id="title">Issued</div>
  <p>A hackclub clothing YSWS.</p>

  <div class="sections">
    <div class="section">
      <h2>YS Designs</h2>
      <p>Create and share your unique design coded to existance.</p>
    </div>

    <div class="section">
      <h2>WS Clothes</h2>
      <p>We order your designs for you to wear.</p>
    </div>
  </div>
</div>