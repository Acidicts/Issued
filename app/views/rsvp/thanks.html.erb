<%= content_for :title, "RSVP Confirmed | Issued" %>

<%= stylesheet_link_tag "pages/rsvp" %>

<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
    }

    h1 {
      margin: 0;
      line-height: 1.1;
      font-family: 'Space Mono', 'Courier New', monospace;
      font-size: clamp(1.5rem, 5vw, 2.8rem);
    }

    p {
      margin-top: 0.9rem;
      font-size: 1.05rem;
      line-height: 1.5;
    }

    .btns {
      margin-top: 1.25rem;
      display: flex;
      gap: 0.7rem;
      flex-wrap: wrap;
    }

    .btn {
      text-decoration: none;
      border-radius: 4px;
      border: 1.5px solid #241D16;
      padding: 0.7rem 1rem;
      color: #241D16;
      font-weight: 700;
      background: #F2EAD3;
      transition: background 160ms ease;
    }

    .btn:hover {
      background: #E4D9BC;
    }

    .btn.primary {
      color: #ffffff;
      background: #241D16;
    }

    @media (max-width: 640px) {
      .box {
        padding: 1.25rem;
      }

      .btn {
        width: 100%;
        text-align: center;
      }
    }
  </style>
<% end %>

<div class="page-shell">
  <main class="box">
    <h1>RSVP Confirmed</h1>
    <p>Your RSVP is saved. Thanks for supporting this YSWS.</p>

    <div class="btns">
      <%= link_to "Go Home", root_path, class: "btn primary" %>
    </div>
  </main>
</div>