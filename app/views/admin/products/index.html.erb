<%= stylesheet_link_tag "pages/admin/products" %>
<%= stylesheet_link_tag "pages/shop" %>

<div class="products">
    <div class="products-heading">
        <h1>Product Management</h1>
        <% if @products.any? %>
            <div class="products-add-buttons">
                <%= link_to 'Add New Product', new_admin_product_path, class: 'btn btn-secondary' %>
                <%= link_to 'Import from Printful', new_by_printful_id_admin_products_path, class: 'btn btn-secondary' %>
            </div>
        <% end %>
    </div>

    <div class="dashed-break"></div>

    <div class="admin-product">
        <% if @products.empty? %>
            <div class="no-product-grid">
                <p>No products found.</p>
                <%= link_to 'Add New Product', new_admin_product_path, class: 'btn' %>
                <%= link_to 'Import from Printful', new_by_printful_id_admin_products_path, class: 'btn' %>
            </div>
        <% else %>
            <div class="admin-product-grid">
                <%= render @products %>
            </div>
        <% end %>
    </div>
</div>
