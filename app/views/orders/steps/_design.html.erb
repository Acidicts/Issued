<%= stylesheet_link_tag "pages/orders", "data-turbo-track": "reload" %>

<% enabled_area_names = @product.print_areas.select { |pa| @order.print_areas[pa.name] == true }.map(&:name) %>
<% current_area_name = params[:print_area].presence || enabled_area_names.first %>
<% current_pa = @product.print_areas.find { |p| p.name == current_area_name } %>
<% current_idx = enabled_area_names.index(current_area_name) || 0 %>

<%= turbo_frame_tag "order_steps" do %>
  <div class="order-wrap" data-controller="order--order-preview"
      data-order--order-preview-image-x-value="<%= current_pa&.image_x %>"
      data-order--order-preview-image-y-value="<%= current_pa&.image_y %>"
      data-order--order-preview-image-wx-value="<%= current_pa&.image_wx %>"
      data-order--order-preview-image-wy-value="<%= current_pa&.image_wy %>"
      data-order--order-preview-color-hex-value="<%= @order.color_hex %>">
    <div class="order-header">
      <h1>Place Your Design</h1>
      <p class="sub">Drag, resize, or rotate the design within the print area.</p>
    </div>

    <div class="order-layout">
      <div class="order-form-side">
        <%= form_with url: new_step_orders_path, method: :post, id: "design-form", data: { turbo_frame: "order_steps" }, html: { class: "form-card" } do |f| %>
          <%= hidden_field_tag "order[product_id]", @product.id %>
          <%= hidden_field_tag "step", "design" %>
          <%= hidden_field_tag "print_area", current_area_name %>
          <%= hidden_field_tag "print_area_nav", "" %>

          <% if enabled_area_names.size > 1 %>
            <div class="print-area-nav" style="display: flex; gap: 8px; align-items: center; margin-bottom: 16px;">
              <button type="button" class="btn btn-tertiary" onclick="document.getElementById('print_area').value='<%= enabled_area_names[current_idx - 1] %>'; document.getElementById('print_area_nav').value='1'; this.closest('form').requestSubmit();"<%= ' disabled' if current_idx <= 0 %>>&lt; Prev</button>
              <span style="line-height: 2;"><%= current_area_name.capitalize %> (<%= current_idx + 1 %> of <%= enabled_area_names.size %>)</span>
              <button type="button" class="btn btn-tertiary" onclick="document.getElementById('print_area').value='<%= enabled_area_names[current_idx + 1] %>'; document.getElementById('print_area_nav').value='1'; this.closest('form').requestSubmit();"<%= ' disabled' if current_idx >= enabled_area_names.size - 1 %>>&gt; Next</button>
            </div>
          <% end %>

          <%# Carry forward config selections %>
          <%= hidden_field_tag "order[color_hex]", @order.color_hex %>
          <% @product.print_areas.each do |pa| %>
            <%= hidden_field_tag "order[print_areas][#{pa.name}]", @order.print_areas[pa.name] == true ? "1" : "0" %>
          <% end %>
          <% @print_area_configs.each do |key, config| %>
            <% next if key.to_s == current_area_name.to_s %>
            <% config.each do |k, value| %>
              <%= hidden_field_tag "order[print_area_configs][#{key}][#{k}]", value %>
            <% end %>
          <% end %>

          <% pa_config = @print_area_configs[current_area_name] || {} %>

          <div class="form-group">
            <label class="form-label" for="order_design_id">
              Design
              <span class="required">*</span>
            </label>
            <% if @designs.any? %>
              <select name="order[print_area_configs][<%= current_area_name %>][design_id]"
                      id="order_design_id"
                      class="form-select"
                      data-action="change->order--order-preview#updateDesign"
                      data-order--order-preview-target="designSelect">
                <option value="">Select a design...</option>
                <% @designs.each do |design| %>
                  <%
                    is_selected = pa_config["design_id"].to_s == design.id.to_s
                    latest_image = design.images.order(created_at: :desc).first
                    img_url = if latest_image&.image_file&.attached?
                                url_for(latest_image.image_file)
                              else
                                ""
                              end
                  %>
                  <option value="<%= design.id %>"
                          data-image-url="<%= img_url %>"
                          <%= 'selected' if is_selected %>>
                    <%= design.name %>
                  </option>
                <% end %>
              </select>
              <p class="form-hint">Pick a design from your collection to preview it on the product.</p>
            <% else %>
              <p class="form-hint" style="color: var(--warn);">You have no designs yet. <%= link_to "Create one first", new_design_path, class: "btn btn-tertiary", data: { turbo: false } %></p>
            <% end %>
          </div>

          <fieldset class="form-fieldset">
            <legend>Design placement</legend>
            <p class="form-hint" style="margin-bottom: 12px;">Drag, resize, or rotate the design within the print area.</p>

            <div class="form-grid">
              <div class="form-group">
                <%= f.label :x, "X position (px)", class: 'form-label' %>
                <%= number_field_tag "order[print_area_configs][#{current_area_name}][x]", pa_config["x"], step: 1, id: "x", class: 'form-input',
                      "data-order--order-preview-target" => "inputX", "data-action" => "input->order--order-preview#inputChanged" %>
              </div>
              <div class="form-group">
                <%= f.label :y, "Y position (px)", class: 'form-label' %>
                <%= number_field_tag "order[print_area_configs][#{current_area_name}][y]", pa_config["y"], step: 1, id: "y", class: 'form-input',
                      "data-order--order-preview-target" => "inputY", "data-action" => "input->order--order-preview#inputChanged" %>
              </div>
            </div>
            <div class="form-grid">
              <div class="form-group">
                <%= f.label :wx, "Width (px)", class: 'form-label' %>
                <%= number_field_tag "order[print_area_configs][#{current_area_name}][wx]", pa_config["wx"], step: 1, id: "wx", class: 'form-input',
                      "data-order--order-preview-target" => "inputWx", "data-action" => "input->order--order-preview#inputChanged" %>
              </div>
              <div class="form-group">
                <%= f.label :wy, "Height (px)", class: 'form-label' %>
                <%= number_field_tag "order[print_area_configs][#{current_area_name}][wy]", pa_config["wy"], step: 1, id: "wy", class: 'form-input',
                      "data-order--order-preview-target" => "inputWy", "data-action" => "input->order--order-preview#inputChanged" %>
              </div>
            </div>
            <div class="form-group">
              <%= f.label :rotation, "Rotation (deg)", class: 'form-label' %>
              <%= number_field_tag "order[print_area_configs][#{current_area_name}][rotation]", pa_config["rotation"] || 0, step: 1, min: 0, max: 360, id: "rotation", class: 'form-input',
                    "data-order--order-preview-target" => "inputRotation", "data-action" => "input->order--order-preview#inputChanged" %>
            </div>
          </fieldset>

          <div class="form-actions">
            <button type="submit" name="back_step" value="config" class="btn btn-secondary btn-outline">Back</button>
            <input type="submit" value="Review Order" class="btn btn-secondary" <%= 'disabled' if @designs.empty? %>>
          </div>
        <% end %>
      </div>

      <div class="order-preview-side">
        <div class="preview-label">Preview</div>
        <div class="preview-canvas"
            data-order--order-preview-target="canvas"
            data-action="mousedown->order--order-preview#dragStart">
          <div class="preview-product">
            <div class="preview-product-image-container">
              <% if current_pa&.template_image %>
              <%= image_tag current_pa.template_image, alt: @product.type, "data-order--order-preview-target" => "productImage", class: "product_image_preview", style: "background-color: #{@order.color_hex}" %>
              <% elsif @product.image.attached? %>
              <%= image_tag @product.image, alt: @product.type, "data-order--order-preview-target" => "productImage", class: "product_image_preview", style: "background-color: #{@order.color_hex}" %>
              <% else %>
                <span class="preview-placeholder">No product image</span>
              <% end %>
            </div>
          </div>
          <div class="preview-print-area"
              data-order--order-preview-target="printArea">
            <span class="preview-print-area-label">Print area</span>
          </div>
          <div class="preview-design-img-wrap"
              data-order--order-preview-target="designImgWrap"
              style="display: none;">
            <img class="preview-design-img" data-order--order-preview-target="designImage" src="" alt="Design preview">
            <div class="resize-handle resize-n" data-dir="n"></div>
            <div class="resize-handle resize-s" data-dir="s"></div>
            <div class="resize-handle resize-e" data-dir="e"></div>
            <div class="resize-handle resize-w" data-dir="w"></div>
            <div class="rotate-handle"></div>
          </div>
          <div class="preview-empty" data-order--order-preview-target="emptyState">
            <span>Select a design to see a preview</span>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
