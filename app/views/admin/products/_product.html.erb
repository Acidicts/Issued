<div>
  <%= render "shared/product", product: product, actions: capture { %>
    <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-seconday" %>
    <%= link_to "Delete", admin_product_path(product), data: { turbo_method: :delete }, class: "btn btn-secondary" do %>
      <%= image_tag %>
    <% end %>
  <% } %>
</div>