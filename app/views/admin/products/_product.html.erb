<div>
  <%= render "shared/product", product: product, actions: capture { %>
    <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-secondary" %>
    <%= link_to admin_product_path(product), data: { turbo_method: :delete }, class: "btn btn-secondary" do %>
      <%= image_tag "icons/bin.svg", height: 18, alt: "Delete" %>
    <% end %>
  <% } %>
</div>