<%= stylesheet_link_tag 'pages/designs.css', "data-turbo-track": "reload" %>

<div class="design-detail design-detail-container design">
  <div class="design-image-preview">
    <% if @design.image_exists? %>
      <div class="design-preview">
        <% image_record = @design.latest_image %>
        <%= image_tag image_record.image_for(:display), alt: "Additional image for #{@design.name}" %>
      </div>
    <% else %>
      <div class="design-preview">
        <div class="mock-image">
          <div class="text-mock-image">
            <p><strong>No Image Preview</strong></p>
            <p>No Image Provided/Exists</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="text-content">
    <div class="design-title-row">
      <div class="design-title-heading">
        <h1><%= @design.name %></h1>
        <h4><%= "By " + @design.user.name %></h4>
      </div>
    </div>
    <div class="design-meta">
      <p class="stat"><%= @design.description %></p>
    </div>
  </div>
  <% if @design.user == current_user %>
    <%= turbo_frame_tag "design_actions_stream" do %>
      <div class="design-actions">
        <%= link_to "Edit design", edit_design_path(@design), class: "button-primary" %>
        <%= link_to next_step_ship_requests_path(design_id: @design.id, step: "overview"), class: "btn-primary#{" disabled" unless @design.can_make_ship_request?}", data: { turbo_frame: "ship_request_steps" }, onclick: "document.getElementById('ship-request-new-page').classList.remove('hidden');" do %>
          Ship 
          <% if !@design.can_make_ship_request? %>
            <%= render "shared/info_icon", aria_label: @design.missing_checks() %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<% if @design.hackatime_projects.any? %>
<% end %>

<div class="designs-hackatime-gallery">
  <%= render "designs/hackatime/projects", design: @design %>

  <%= render "designs/images/gallery", design: @design %>
</div>

<%= render "designs/devlogs/devlogs", design: @design %>

<div class="popups">
  <%= render "ship_requests/form_box" %>
</div>
