# Hackclub Stuff
HACKCLUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HACKCLUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

HACKATIME_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HACKATIME_START_DATE=yyyy-mm-dd

CDN_URL=https://cdn.hackclub.com/api/v4
CDN_KEY=sk_cdn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Active Storage (Cloudflare R2 over S3). R2_ACCOUNT_ID is the account id from the
# R2 overview page; the access key and secret come from R2 -> Manage R2 Tokens.
# Create the bucket first. Public access is not needed: Active Storage serves
# objects through short-lived signed URLs.
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=xxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Active Record encryption (encrypts :hackclub_access_token / :hackclub_refresh_token)
# Generate new values with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack
SLACK_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site Operations
CURRENCY_NAME=Threads
APP_URL=
EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxxxx

# Will change to site setting later
RUNNING=false
ENDED=false
RSVP_OPEN=false

PORT=3000

# Customisations
ORG_SLACK_IDS=xxxxxxxx
ORG_TITLES=Organizer

CURRENCY_NAME=Threads

# Site
RAILS_ENV=
SECRET_KEY_BASE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAILS_MASTER_KEY=

DISALLOWED_WORDS= []
HELP_SLACK_ID=

# Database & Cache Locations (Derived Programmatically)
DB_URL=postgres://postgres:postgres@localhost:5432/issued_development
REDIS_URL=redis://localhost:6379/0
