<div class="comment-card">
    <div class="comment-card-contents">
        <div class="comment-card-header">
            <div>
                <h3>Review by <%= render_encoded("{{reviewer-user:#{review.user.id}}}") %></h3>
                <% if review.created_at %>
                    <time class="comment-card-date" datetime="<%= review.created_at.iso8601 %>">
                        <%= review.created_at.strftime("%b %d, %Y") %>
                    </time>
                <% end %>
            </div>
        </div>
        <% if current_user.reviewer? && review.proof_file.attached? %>
            <video style="max-width: 300px; height: auto;" src="<%= url_for(review.proof_file) %>" controls></video>
        <% end %>
        <div class="comment-card-body markdown-content">
            <%= raw MarkdownService.convert(content: review.comment) %>
        </div>
    </div>
</div>