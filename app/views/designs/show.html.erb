<%= stylesheet_link_tag 'pages/designs.css', "data-turbo-track": "reload" %>

<div class="design-detail design-detail-container design">
  <div class="design-image-preview">
    <% if @design.image_exists? %>
      <div class="design-preview">
        <%= image_tag @design.image?.variant(:display), alt: "Additional image for #{@design.name}" %>
      </div>
    <% else %>
      <div class="design-preview">
        <div class="mock-image">
          <div class="text-mock-image">
            <p><strong>No Image Preview</strong></p>
            <p>No Image Provided/Exists</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="text-content">
    <div class="design-title-row">
      <div class="design-title-heading">
        <h1><%= @design.name %></h1>
        <h4><%= "By " + @design.user.name %></h4>
      </div>
      <div class="design-actions">
        <%= link_to "Edit design", edit_design_path(@design), class: "button-primary" %>
      </div>
    </div>
    <div class="design-meta">
      <p class="stat"><%= @design.description %></p>
    </div>
  </div>
</div>

<% if @design.images.any? %>
  <div class="project-image-gallery">
    <h2>Project Design Image</h2>
    <div class="image-gallery-grid">
      <%= render partial: "designs/image_gallery_preview", collection: @design.images.order(created_at: :desc), as: :image %>
    </div>
  </div>
<% end %>
