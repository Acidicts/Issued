<div class="project-image-gallery">
  <h2>Project Design Image</h2>
    <% gallery_images = design.images
        .where(
          "devlog_type = 'Devlog' OR (devlog_type = 'ShipRequest' AND EXISTS (SELECT 1 FROM ship_requests WHERE ship_requests.id = images.devlog_id AND ship_requests.status = ?))",
          ShipRequest.statuses[:approved]
        )
        .order(created_at: :desc).limit(10).to_a %>
    <% if gallery_images.present? %>
        <div class="image-gallery-grid">
            <%= render partial: "designs/images/image_gallery_preview",
                collection: gallery_images,
                as: :image %>
        </div>
    <% else %>
        <div class="image-gallery-grid">
            <div class="image-history-preview">
                <div class="image-history-placeholder">
                    <span class="image-history-placeholder__text">
                        You get a Placeholder;
                        Here ya go
                    </span>
                </div>
                <div class="image-history-overlay">
                    <time datetime="<%= Time.current.iso8601 %>"><%= Time.current.strftime("%b %d, %Y at %I:%M %p") %></time>
                </div>
            </div>
        </div>
    <% end %>
</div>